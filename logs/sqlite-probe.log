
========== 0. 環境 ==========
$ sqlite3 --version
3.45.1 2024-01-30 16:01:20 e876e51a0ed5c5b3126f52e532044363a014bc594cfefa87ffb5b82257ccalt1 (64-bit)
[exit 0]

========== 1. DB はファイル1個である（サーバが無い） ==========
$ sqlite3 notes.db 'CREATE TABLE notes(id INTEGER PRIMARY KEY, body TEXT); INSERT INTO notes(body) VALUES("hello");'
[exit 0]
$ ls -la notes.db
-rw-r--r-- 1 lab lab 8192 Oct  5 20:27 notes.db
[exit 0]
$ file notes.db
notes.db: SQLite 3.x database, last written using SQLite version 3045001, file counter 2, database pages 2, cookie 0x1, schema 4, UTF-8, version-valid-for 2
[exit 0]
$ xxd -l 16 notes.db
00000000: 5351 4c69 7465 2066 6f72 6d61 7420 3300  SQLite format 3.
[exit 0]
--- 常駐プロセスを探す。角括弧の有無で結果が割れる ---
$ ps -ef | grep -c "[s]qlite"
0
[exit 1]
$ ps -ef | grep -c "sqlite"
1
[exit 0]
--- ↑ 1 のほうは grep 自身の行。何がヒットしたか ---
$ ps -ef | grep "sqlite"
lab           19       1  0 20:27 ?        00:00:00 grep sqlite
[exit 0]
注: ps -ef の全体はこの探査スクリプト自身が出るため、読者の画面とは一致しない。
    本文には載せない（PID・時刻・起動の仕方で変わる）。

========== 2. 型は宣言ではなく提案（type affinity） ==========
$ sqlite3 t2.db 'CREATE TABLE loose(n INTEGER);'
[exit 0]
$ sqlite3 t2.db 'INSERT INTO loose VALUES(42);'
[exit 0]
$ sqlite3 t2.db 'INSERT INTO loose VALUES("abc");'
[exit 0]
$ sqlite3 t2.db 'SELECT n, typeof(n) FROM loose;'
42|integer
abc|text
[exit 0]
--- INTEGER 列に \"123\" を入れると数値に変換される（\"abc\" は文字列のまま） ---
$ sqlite3 t2.db 'INSERT INTO loose VALUES("123"); SELECT n, typeof(n) FROM loose;'
42|integer
abc|text
123|integer
[exit 0]
--- STRICT テーブルなら拒否されるか ---
$ sqlite3 t2.db 'CREATE TABLE tight(n INTEGER) STRICT;'
[exit 0]
$ sqlite3 t2.db 'INSERT INTO tight VALUES("abc");'
Error: stepping, cannot store TEXT value in INTEGER column tight.n (19)
[exit 19]
$ sqlite3 t2.db 'INSERT INTO tight VALUES(7); SELECT n, typeof(n) FROM tight;'
7|integer
[exit 0]

========== 3. トランザクションの有無で速度が変わる ==========
--- 素で 2000 行 INSERT ---
$ time sqlite3 t3a.db 'CREATE TABLE a(n INTEGER);' $(for i in $(seq 1 200); do printf '"INSERT INTO a VALUES(%s);" ' $i; done)
Error: in prepare, unrecognized token: ""INSERT"
  "INSERT
  ^--- error here

real	0m0.018s
user	0m0.003s
sys	0m0.009s
[exit 1]
--- 1行1トランザクション（既定） ---
$ time bash naive.sh

real	0m13.069s
user	0m0.093s
sys	0m0.506s
[exit 0]
$ sqlite3 t3a.db 'SELECT count(*) FROM a;'
2000
[exit 0]
--- BEGIN...COMMIT で囲む ---
$ time bash txn.sh

real	0m0.048s
user	0m0.032s
sys	0m0.016s
[exit 0]
$ sqlite3 t3b.db 'SELECT count(*) FROM b;'
2000
[exit 0]

========== 4. 同時書き込みでロックする ==========
$ sqlite3 lock.db 'CREATE TABLE t(n INTEGER);'
[exit 0]
$ sqlite3 lock.db 'PRAGMA journal_mode;'
delete
[exit 0]
--- 別プロセスから書き込む（既定 journal_mode=delete, busy_timeout=0） ---
$ sqlite3 lock.db 'INSERT INTO t VALUES(2);'
Error: stepping, database is locked (5)
[exit 5]
--- 読み取りはできるか ---
$ sqlite3 lock.db 'SELECT count(*) FROM t;'
0
[exit 0]
$ sqlite3 lock.db 'SELECT count(*) FROM t;'
1
[exit 0]
--- WAL に変えて同じことをする ---
$ sqlite3 wal.db 'PRAGMA journal_mode=WAL; CREATE TABLE t(n INTEGER);'
wal
[exit 0]
$ ls wal.db*
wal.db
[exit 0]
--- WAL でも書き込みは1つだけか ---
$ sqlite3 wal.db 'INSERT INTO t VALUES(2);'
Error: stepping, database is locked (5)
[exit 5]
--- WAL なら読み取りは待たされないか ---
$ sqlite3 wal.db 'SELECT count(*) FROM t;'
0
[exit 0]
$ ls wal.db*
wal.db
[exit 0]

========== 5. ディレクトリに書けないと DB にも書けない ==========
$ sqlite3 subdir/d.db 'CREATE TABLE t(n INTEGER); INSERT INTO t VALUES(1);'
[exit 0]
$ ls -la subdir/
total 16
drwxr-xr-x 2 lab lab 4096 Oct  5 20:27 .
drwx------ 3 lab lab 4096 Oct  5 20:27 ..
-rw-r--r-- 1 lab lab 8192 Oct  5 20:27 d.db
[exit 0]
--- DB ファイル自体は書き込み可のまま、ディレクトリだけ読み取り専用にする ---
$ chmod 555 subdir
[exit 0]
$ ls -ld subdir; ls -l subdir/d.db
dr-xr-xr-x 2 lab lab 4096 Oct  5 20:27 subdir
-rw-r--r-- 1 lab lab 8192 Oct  5 20:27 subdir/d.db
[exit 0]
$ sqlite3 subdir/d.db 'INSERT INTO t VALUES(2);'
Error: stepping, attempt to write a readonly database (8)
[exit 8]
--- 読み取りはできるか ---
$ sqlite3 subdir/d.db 'SELECT count(*) FROM t;'
1
[exit 0]
--- WAL でも同じか ---
$ sqlite3 subdir/d.db 'PRAGMA journal_mode=WAL;'
Error: stepping, attempt to write a readonly database (8)
[exit 8]
--- ディレクトリを戻すと書けるか ---
$ chmod 755 subdir
[exit 0]
$ sqlite3 subdir/d.db 'INSERT INTO t VALUES(2); SELECT count(*) FROM t;'
2
[exit 0]

========== 6. 参考: 壊れたファイルを開くとどうなるか ==========
$ printf "not a database at all, just text" > broken.db
[exit 0]
$ sqlite3 broken.db 'SELECT 1;'
1
[exit 0]
$ sqlite3 broken.db 'PRAGMA integrity_check;'
Error: in prepare, file is not a database (26)
[exit 26]

========== 完了 ==========
