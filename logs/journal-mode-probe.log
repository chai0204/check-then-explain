
========== 0. 既定値 ==========
$ sqlite3 d.db 'CREATE TABLE t(n INTEGER); INSERT INTO t VALUES(1);'
[exit 0]
$ sqlite3 d.db 'PRAGMA journal_mode;'
delete
[exit 0]
$ sqlite3 d.db 'PRAGMA wal_autocheckpoint;'
1000
[exit 0]
$ sqlite3 d.db 'PRAGMA synchronous;'
2
[exit 0]

========== 1. delete モード: 書き込み中にだけ -journal が現れる ==========
$ ls d.db*
d.db
[exit 0]
$ ls -l d.db*
-rw-r--r-- 1 lab lab 8192 Oct  5 22:38 d.db
-rw-r--r-- 1 lab lab 4616 Oct  5 22:38 d.db-journal
[exit 0]
$ xxd -l 32 d.db-journal 2>/dev/null || echo "(-journal が無い)"
00000000: 0000 0000 0000 0000 0000 0000 c7b6 63d2  ..............c.
00000010: 0000 0002 0000 0200 0000 1000 0000 0000  ................
[exit 0]
--- 解放後 ---
$ ls d.db*
d.db
[exit 0]

========== 2. delete モード: 読み取りを保持すると書き込みは通るか ==========
$ sqlite3 d.db 'INSERT INTO t VALUES(2);'
Error: stepping, database is locked (5)
[exit 5]
$ sqlite3 d.db 'INSERT INTO t VALUES(2); SELECT count(*) FROM t;'
3
[exit 0]

========== 3. WAL に切り替える ==========
$ sqlite3 w.db 'CREATE TABLE t(n INTEGER); INSERT INTO t VALUES(1);'
[exit 0]
$ sqlite3 w.db 'PRAGMA journal_mode=WAL;'
wal
[exit 0]
$ ls -l w.db*
-rw-r--r-- 1 lab lab 8192 Oct  5 22:38 w.db
[exit 0]
--- 別プロセスで開いても wal か（ファイルに永続化されているか） ---
$ sqlite3 w.db 'PRAGMA journal_mode;'
wal
[exit 0]

========== 4. WAL モード: 書き込み中に現れるファイル ==========
$ ls -l w.db*
-rw-r--r-- 1 lab lab  8192 Oct  5 22:38 w.db
-rw-r--r-- 1 lab lab 32768 Oct  5 22:38 w.db-shm
-rw-r--r-- 1 lab lab     0 Oct  5 22:38 w.db-wal
[exit 0]
$ xxd -l 32 w.db-wal 2>/dev/null || echo "(-wal が無い)"
[exit 0]
--- 解放後（-wal は残るか） ---
$ ls -l w.db*
-rw-r--r-- 1 lab lab 8192 Oct  5 22:38 w.db
[exit 0]

========== 5. WAL モード: 読み取りを保持しても書き込めるか（WAL の本当の利点） ==========
$ sqlite3 w.db 'INSERT INTO t VALUES(2);'
[exit 0]
$ sqlite3 w.db 'SELECT count(*) FROM t;'
3
[exit 0]

========== 6. WAL モード: 書き込みを保持したら、別の書き込みと読み取りはどうなるか ==========
$ sqlite3 w.db 'INSERT INTO t VALUES(3);'
Error: stepping, database is locked (5)
[exit 5]
$ sqlite3 w.db 'SELECT count(*) FROM t;'
3
[exit 0]

========== 7. チェックポイント ==========
$ ls -l w.db*
-rw-r--r-- 1 lab lab 8192 Oct  5 22:38 w.db
[exit 0]
$ sqlite3 w.db 'PRAGMA wal_checkpoint(TRUNCATE);'
0|0|0
[exit 0]
$ ls -l w.db*
-rw-r--r-- 1 lab lab 8192 Oct  5 22:38 w.db
[exit 0]
