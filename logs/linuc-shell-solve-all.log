$ printf '#!/bin/bash\n# logs/ にある .log ファイルごとに行数を数え、最後に合計を出す。\ntotal=0\nfor f in logs/*.log; do\n    n=0\n    while read -r line; do\n        n=$((n + 1))\n    done < "$f"\n    echo "$f: $n 行"\n    total=$((total + n))\ndone\necho "合計: $total 行"\n' > count.sh; cat count.sh
#!/bin/bash
# logs/ にある .log ファイルごとに行数を数え、最後に合計を出す。
total=0
for f in logs/*.log; do
    n=0
    while read -r line; do
        n=$((n + 1))
    done < "$f"
    echo "$f: $n 行"
    total=$((total + n))
done
echo "合計: $total 行"

