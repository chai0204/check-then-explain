$ printf '#!/bin/bash\necho "1) ユーザ名  2) ホスト名  q) 終了"\nwhile read -r ans; do\n    case "$ans" in\n        1) id -un ;;\n        2) hostname ;;\n        q) echo "終了します"; exit 0 ;;\n        *) echo "1・2・q のどれかを入力してください" ;;\n    esac\ndone\n' > menu.sh; cat menu.sh
#!/bin/bash
echo "1) ユーザ名  2) ホスト名  q) 終了"
while read -r ans; do
    case "$ans" in
        1) id -un ;;
        2) hostname ;;
        q) echo "終了します"; exit 0 ;;
        *) echo "1・2・q のどれかを入力してください" ;;
    esac
done

