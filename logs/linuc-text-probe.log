$ echo '私は $(whoami) です'
私は $(whoami) です

$ echo "私は `whoami` です"
私は lab です

$ echo a     b
a b

$ echo "a     b"
a     b

$ msg="a     b"

$ echo $msg
a b

$ echo "$msg"
a     b

$ echo *.csv
scores.csv

$ echo "*.csv"
*.csv

$ echo -e 'a\tb'
a	b

$ echo 'a\tb'
a\tb

$ echo -n "改行なし"; echo "←ここまでが1行"
改行なし←ここまでが1行

$ cat child.sh
#!/bin/bash
echo "子のプロセスから見た GREETING=[$GREETING]"

$ GREETING=hello

$ echo "$GREETING"
hello

$ bash child.sh
子のプロセスから見た GREETING=[]

$ export GREETING

$ bash child.sh
子のプロセスから見た GREETING=[hello]

$ env | grep GREETING
GREETING=hello

$ set | grep "^GREETING="
GREETING=hello

$ LOCAL_ONLY=here

$ set | grep "^LOCAL_ONLY="
LOCAL_ONLY=here

$ env | grep "^LOCAL_ONLY="; echo "exit=$?"
exit=1

$ export -p | grep GREETING
declare -x GREETING="hello"

$ GREETING=bye bash child.sh
子のプロセスから見た GREETING=[bye]

$ echo "$GREETING"
hello

$ env GREETING=env-bye bash child.sh
子のプロセスから見た GREETING=[env-bye]

$ env -i bash child.sh
子のプロセスから見た GREETING=[]

$ unset GREETING

$ echo "[$GREETING]"
[]

$ bash child.sh
子のプロセスから見た GREETING=[]

$ X=1 echo "[$X]"
[]

$ X=1; echo "[$X]"
[1]

$ unset X

$ set -o | grep -E "^(noclobber|xtrace|history) "
