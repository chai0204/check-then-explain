

========== 第1章 virsh は電源を入れ、止まるよう頼むだけ（1.01.2） ==========

# --- 画面の写し: 定義はあるが、電源が入っていない ---
$ virsh list
 Id   Name   State
--------------------

$ virsh list --all
 Id   Name    State
------------------------
 -    linuc   shut off

$ virsh dominfo linuc
Id:             -
Name:           linuc
UUID:           4485210e-c3f9-4db5-93ff-953c9ea25cf6
OS Type:        hvm
State:          shut off
CPU(s):         2
Max memory:     1572864 KiB
Used memory:    1572864 KiB
Persistent:     yes
Autostart:      disable
Managed save:   no
Security model: none
Security DOI:   0

$ virsh dumpxml linuc | grep -E '<domain|<memory|<vcpu|<os|<loader|<nvram|<source file|<target dev|<serial|<console'
<domain type='qemu' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <memory unit='KiB'>1572864</memory>
  <vcpu placement='static'>2</vcpu>
  <os firmware='efi'>
    <loader readonly='yes' secure='yes' type='pflash'>/usr/share/OVMF/OVMF_CODE_4M.ms.fd</loader>
    <nvram template='/usr/share/OVMF/OVMF_VARS_4M.ms.fd'>/home/lab/vm/linuc_VARS.fd</nvram>
      <source file='/home/lab/vm/linuc.qcow2'/>
      <target dev='vda' bus='virtio'/>
    <serial type='pty'>
    <console type='pty'>
$ ls -l ~/vm
total 200
-rw-r--r-- 1 lab lab      0 Oct 13 20:40 define.log
-rw-r--r-- 1 lab lab 196928 Oct 13 20:40 linuc.qcow2
-rw-r--r-- 1 lab lab   2240 Oct 13 20:40 linuc.xml
-rw-r--r-- 1 lab lab      0 Oct 13 20:40 provision-watch.log
$ qemu-img info ~/vm/linuc.qcow2 | grep -E '^(image|file format|virtual size|backing file):'
image: /home/lab/vm/linuc.qcow2
file format: qcow2
virtual size: 20 GiB (21474836480 bytes)
backing file: /var/lib/lab-vm/linuc-guest.qcow2
$

# --- ここまで ---

# --- 画面の写し: 電源を入れた直後（もう1つの端末で） ---
$ virsh domstate linuc
running

$ virsh qemu-agent-command linuc '{"execute":"guest-ping"}'
error: Guest agent is not responding: QEMU guest agent is not connected

$

# --- ここまで ---

