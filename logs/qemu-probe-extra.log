========== 2. 第1章・第5章・第7章: -machine の値が、どの版のマシン型になるか（QMP の qom-get /machine type） ==========

$ qemu-system-x86_64 -machine help | grep -E '^(ubuntu|pc|ubuntu-q35|q35) '
ubuntu               Ubuntu 24.04 PC v2 (i440FX + PIIX, arch_caps fix, 1996) (alias of pc-i440fx-noble-v2)
pc                   Ubuntu 24.04 PC (i440FX + PIIX, 1996) (alias of pc-i440fx-noble)
pc                   Standard PC (i440FX + PIIX, 1996) (alias of pc-i440fx-8.2)
ubuntu-q35           Ubuntu 24.04 PC v2 (Q35 + ICH9, arch_caps fix, 2009) (alias of pc-q35-noble-v2)
q35                  Ubuntu 24.04 PC (Q35 + ICH9, 2009) (alias of pc-q35-noble)
q35                  Standard PC (Q35 + ICH9, 2009) (alias of pc-q35-8.2)

$ for m in "" "-machine pc" "-machine q35" "-machine ubuntu"; do
>   qemu-system-x86_64 $m -display none -S -qmp unix:m.sock,server=on,wait=off -daemonize
>   printf "%-18s → " "${m:-（指定なし）}"
>   printf "%s\n" "{\"execute\":\"qmp_capabilities\"}" "{\"execute\":\"qom-get\",\"arguments\":{\"path\":\"/machine\",\"property\":\"type\"}}" "{\"execute\":\"quit\"}" | socat -t 3 - UNIX-CONNECT:m.sock 2>/dev/null | grep -o "\"return\": \"[^\"]*\""
>   while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.2; done
> done
（指定なし） → "return": "pc-i440fx-noble-v2-machine"
-machine pc        → "return": "pc-i440fx-8.2-machine"
-machine q35       → "return": "pc-q35-8.2-machine"
-machine ubuntu    → "return": "pc-i440fx-noble-v2-machine"


========== 3. 第2章・演習01: -nographic と -daemonize（行き先を全部指定すれば通る） ==========

$ qemu-system-x86_64 -nographic -daemonize; echo "終了コード: $?"
qemu-system-x86_64: -nographic cannot be used with -daemonize
終了コード: 1

$ qemu-system-x86_64 -nographic -daemonize -serial file:serial.log -qmp unix:qmp.sock,server=on,wait=off; echo "終了コード: $?"
qemu-system-x86_64: -nographic cannot be used with -daemonize
終了コード: 1

$ qemu-system-x86_64 -nographic -daemonize -serial file:serial.log -qmp unix:qmp.sock,server=on,wait=off -parallel none; echo "終了コード: $?"
終了コード: 0

$ printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"qom-get","arguments":{"path":"/machine","property":"graphics"}}' '{"execute":"quit"}' | socat - UNIX-CONNECT:qmp.sock
{"QMP": {"version": {"qemu": {"micro": 2, "minor": 2, "major": 8}, "package": "Debian 1:8.2.2+ds-0ubuntu1.18"}, "capabilities": ["oob"]}}
{"return": {}}
{"return": false}
{"timestamp": {"seconds": 1791918738, "microseconds": 429941}, "event": "SHUTDOWN", "data": {"guest": false, "reason": "host-qmp-quit"}}
{"return": {}}


========== 4. 第2章: -nographic のときの線のつながり方（端末が要るので script で疑似端末を作る。Ctrl-a c で切り替えて info chardev） ==========

$ { sleep 3; printf '\001c'; sleep 1; printf 'info chardev\r'; sleep 1; printf 'quit\r'; sleep 1; } | script -qec 'qemu-system-x86_64 -nographic' /dev/null | tr -d '\r' | grep -a 'filename='
parallel0: filename=null
serial0: filename=mux
serial0-base: filename=stdio


========== 5. 第2章: Ctrl-C（0x03）は、-serial stdio なら QEMU を止め、-serial mon:stdio なら仮想の PC に届く ==========

$ { sleep 3; printf '\003'; sleep 2; } | script -qec 'qemu-system-x86_64 -display none -serial stdio' /dev/null | tr -d '\r'; echo "QEMU のプロセス: $(pgrep -c -x qemu-system-x86) 個"
qemu-system-x86_64: terminating on signal 2
QEMU のプロセス: 0 個

$ { sleep 3; printf '\003'; sleep 2; echo "Ctrl-C の2秒後の QEMU のプロセス: $(pgrep -c -x qemu-system-x86) 個" >&2; printf '\001x'; sleep 1; } | script -qec 'qemu-system-x86_64 -display none -serial mon:stdio' /dev/null | tr -d '\r'
Ctrl-C の2秒後の QEMU のプロセス: 1 個
QEMU: Terminated


========== 6. 第2章: QMP のソケットのファイルが残るのは、-daemonize が作業ディレクトリを / に移すから ==========

$ mkdir -p sock && cd sock && ls -A

$ qemu-system-x86_64 -display none -qmp unix:rel.sock,server=on,wait=off -daemonize; readlink /proc/$(pgrep -x qemu-system-x86)/cwd
/

$ printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' | socat -t 2 - UNIX-CONNECT:rel.sock > /dev/null 2>&1; while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.2; done; ls *.sock
rel.sock

$ qemu-system-x86_64 -display none -qmp unix:$PWD/abs.sock,server=on,wait=off -daemonize; printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' | socat -t 2 - UNIX-CONNECT:abs.sock > /dev/null 2>&1; while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.2; done; ls *.sock
rel.sock

$ qemu-system-x86_64 -display none -qmp unix:bg.sock,server=on,wait=off > /dev/null 2>&1 & until [ -S bg.sock ]; do sleep 0.2; done; printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' | socat -t 2 - UNIX-CONNECT:bg.sock > /dev/null 2>&1; wait; ls *.sock
rel.sock

$ cd .. && rm -rf sock first.sock m.sock qmp.sock serial.log && ls -A


========== 7. 第3章: -snapshot の一時ファイルは、開いた直後に名前が消されている ==========

$ qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 snap.qcow2

$ qemu-system-x86_64 -display none -drive file=snap.qcow2,if=virtio -snapshot -qmp unix:s.sock,server=on,wait=off -daemonize

$ ls -A /var/tmp

$ for fd in /proc/$(pgrep -x qemu-system-x86)/fd/*; do readlink $fd; done | grep -E "qcow2|/var/tmp"
/home/lab/work/x/snap.qcow2
/var/lib/lab-vm/linuc-guest.qcow2
/var/tmp/vl.SKB0W3 (deleted)

$ printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' | socat -t 2 - UNIX-CONNECT:s.sock > /dev/null 2>&1; while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.2; done; rm -f snap.qcow2


========== 8. 第3章: 内部スナップショットを消すと、ふつうは disk size が減る。loadvm で戻った後は減らない ==========

$ qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 d.qcow2

$ hmp() { printf "%s\n" "{\"execute\":\"qmp_capabilities\"}" "{\"execute\":\"human-monitor-command\",\"arguments\":{\"command-line\":\"$1\"}}" | socat -t 600 - UNIX-CONNECT:q.sock > /dev/null 2>&1; }
> boot() { : > ser.log; qemu-system-x86_64 -m 1536 -smp 2 -drive file=d.qcow2,if=virtio -display none -serial file:ser.log -qmp unix:q.sock,server=on,wait=off -daemonize; until grep -q "login:" ser.log; do sleep 1; done; }
> halt() { printf "%s\n" "{\"execute\":\"qmp_capabilities\"}" "{\"execute\":\"quit\"}" | socat -t 3 - UNIX-CONNECT:q.sock > /dev/null 2>&1; while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.3; done; }
> size() { echo "ls -l $(stat -c %s d.qcow2) バイト / $(qemu-img info d.qcow2 | grep "^disk size")"; }
> echo "（hmp・boot・halt・size を定義した）"
（hmp・boot・halt・size を定義した）

$ boot; hmp "savevm s1"; halt; size
ls -l 368640000 バイト / disk size: 351 MiB

$ qemu-img snapshot -d s1 d.qcow2; size
ls -l 368640000 バイト / disk size: 7.63 MiB

$ boot; hmp "savevm s2"; hmp "loadvm s2"; halt; size
ls -l 375652352 バイト / disk size: 358 MiB

$ qemu-img snapshot -d s2 d.qcow2; size
ls -l 375652352 バイト / disk size: 358 MiB

$ rm -f d.qcow2 ser.log


========== 9. 第6章: NVRAM を qcow2 で渡すと savevm は通る。第6章の並べ方（NVRAM が先）では、動いている状態は NVRAM の qcow2 のほうに入る ==========

$ qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 d.qcow2; qemu-img convert -O qcow2 /usr/share/OVMF/OVMF_VARS_4M.fd vars.qcow2

$ : > ser.log; qemu-system-x86_64 -machine q35 -m 1536 -smp 2 -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd -drive if=pflash,format=qcow2,file=vars.qcow2 -drive file=d.qcow2,if=virtio -display none -serial file:ser.log -qmp unix:q.sock,server=on,wait=off -daemonize; until grep -q "login:" ser.log; do sleep 1; done; hmp "savevm s1"; halt

$ qemu-img snapshot -l vars.qcow2
Snapshot list:
ID        TAG               VM SIZE                DATE     VM CLOCK     ICOUNT
1         s1                395 MiB 2026-10-14 04:14:08 00:00:31.082           

$ qemu-img snapshot -l d.qcow2
Snapshot list:
ID        TAG               VM SIZE                DATE     VM CLOCK     ICOUNT
1         s1                    0 B 2026-10-14 04:14:08 00:00:31.082           

$ rm -f d.qcow2 vars.qcow2 ser.log


========== 10. 第5章: 練習機の OS がまだネットワークを上げていないとき、hostfwd の入口は接続を受け取ったまま返事をしない（ディスクの無い PC で試す） ==========

$ qemu-system-x86_64 -display none -netdev user,id=n0,hostfwd=tcp:127.0.0.1:2222-:22 -device virtio-net-pci,netdev=n0 -qmp unix:h.sock,server=on,wait=off -daemonize

$ SECONDS=0; exec 3<>/dev/tcp/127.0.0.1/2222 && echo "つながった: ${SECONDS} 秒"; cat <&3; echo "切れた: ${SECONDS} 秒"; exec 3<&-
つながった: 0 秒
切れた: 82 秒

$ SECONDS=0; ssh -o ConnectTimeout=30 linuc true; echo "ssh の終了コード: $? / ${SECONDS} 秒"
Connection timed out during banner exchange
Connection to 127.0.0.1 port 2222 timed out
ssh の終了コード: 255 / 30 秒

$ printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' | socat -t 2 - UNIX-CONNECT:h.sock > /dev/null 2>&1; while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.2; done


========== 11. 第5章: 練習機が起動していて待ち受けが無い番号は、すぐ切られる。127.0.0.1 以外から来た接続は、そのアドレスのまま見える ==========

$ qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 d.qcow2

$ qemu-system-x86_64 -machine q35 -m 1536 -smp 2 -drive file=d.qcow2,if=virtio -netdev user,id=n0,hostfwd=tcp:127.0.0.1:2222-:22,hostfwd=tcp:127.0.0.1:2223-:23,hostfwd=tcp::2224-:22 -device virtio-net-pci,netdev=n0,addr=0x10 -display none -serial file:ser.log -qmp unix:q.sock,server=on,wait=off -daemonize

$ until ssh -o ConnectTimeout=3 linuc true 2>/dev/null; do sleep 3; done; echo "ssh linuc に入れた"
ssh linuc に入れた

$ SECONDS=0; exec 3<>/dev/tcp/127.0.0.1/2223 && echo "2223 につながった: ${SECONDS} 秒"; cat <&3; echo "切れた: ${SECONDS} 秒"; exec 3<&-
2223 につながった: 0 秒
切れた: 0 秒

$ ip -br -4 addr show eth0
eth0@if2383      UP             172.17.0.7/16 

$ ssh linuc 'echo $SSH_CONNECTION'
10.0.2.2 34042 10.0.2.15 22

$ ssh -o HostName=$(ip -br -4 addr show eth0 | awk '{print $3}' | cut -d/ -f1) -o Port=2224 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR linuc 'echo $SSH_CONNECTION'
172.17.0.7 52558 10.0.2.15 22

$ halt; rm -f d.qcow2 ser.log


========== 12. 第4章・演習04: 5秒の -d in_asm の塊の数（5回）と、何度も翻訳された番地 ==========

$ for i in 1 2 3 4 5; do timeout 5 qemu-system-x86_64 -display none -d in_asm -D tcg$i.log 2>/dev/null; echo "$i 回目: IN: $(grep -c '^IN:' tcg$i.log) 個 / 番地の種類 $(grep -A1 '^IN:' tcg$i.log | grep '^0x' | sort -u | wc -l)"; done
