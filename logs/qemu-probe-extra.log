     82 0x0009c534:  
      7 0x000ca26e:  

$ rm -f tcg?.log


========== 13. 地形図: ライブマイグレーションは特権が要らない（同じ檻の中の QEMU から QEMU へ移す） ==========

$ grep CapEff /proc/self/status
CapEff:	0000000000000000

$ qemu-system-x86_64 -display none -qmp unix:dst.sock,server=on,wait=off -incoming tcp:127.0.0.1:4444 -daemonize; qemu-system-x86_64 -display none -qmp unix:src.sock,server=on,wait=off -daemonize

$ printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"migrate","arguments":{"uri":"tcp:127.0.0.1:4444"}}' | socat - UNIX-CONNECT:src.sock
{"QMP": {"version": {"qemu": {"micro": 2, "minor": 2, "major": 8}, "package": "Debian 1:8.2.2+ds-0ubuntu1.18"}, "capabilities": ["oob"]}}
{"return": {}}
{"return": {}}

$ sleep 3; printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"query-migrate"}' | socat - UNIX-CONNECT:src.sock | tail -1 | jq -c '.return | {status, "total-time"}'
{"status":"completed","total-time":5}

$ for s in src dst; do printf '%s: ' $s; printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"query-status"}' '{"execute":"quit"}' | socat -t 2 - UNIX-CONNECT:$s.sock 2>/dev/null | grep -o '"status": "[a-z-]*"'; done; while pgrep -x qemu-system-x86 > /dev/null; do sleep 0.2; done
src: "status": "postmigrate"
dst: "status": "running"


