========== 17. 第3章の注: 練習機のコンソールのプロンプトが消えるとき（\r と空白と \r）と、systemd-fsckd の退場の時刻 ==========

$ qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 d.qcow2

$ qemu-system-x86_64 -machine q35 -m 1536 -smp 2 -drive file=d.qcow2,if=virtio -netdev user,id=n0,hostfwd=tcp:127.0.0.1:2222-:22 -device virtio-net-pci,netdev=n0,addr=0x10 -display none -chardev socket,id=s0,path=ser.sock,server=on,wait=on -serial chardev:s0 -qmp unix:q.sock,server=on,wait=off > /dev/null 2>&1 &
> until [ -S ser.sock ]; do sleep 0.1; done
