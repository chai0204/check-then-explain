========== 16. 第3章・第6章・演習03: savevm の状態は、-drive で先に並べた書き込める qcow2 に入る（電源を入れて数秒で保存する） ==========

$ order() { : > ser.log; qemu-system-x86_64 "$@" -display none -qmp unix:q.sock,server=on,wait=off -daemonize; sleep 5; hmp "savevm s1"; halt; }
> show() { for f in "$@"; do printf "%-12s VM SIZE %s\n" $f "$(qemu-img snapshot -l $f | awk "NR==3{print \$3, \$4}")"; done; }
> CODE="-drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"
> echo "（order・show を定義した）"
（order・show を定義した）

$ qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 d.qcow2; qemu-img convert -O qcow2 /usr/share/OVMF/OVMF_VARS_4M.fd vars.qcow2

$ order -machine q35 -m 1536 $CODE -drive if=pflash,format=qcow2,file=vars.qcow2 -drive file=d.qcow2,if=virtio; show vars.qcow2 d.qcow2
vars.qcow2   VM SIZE 108 MiB
d.qcow2      VM SIZE 0 B

$ rm -f d.qcow2 vars.qcow2; qemu-img create -q -f qcow2 -b /var/lib/lab-vm/linuc-guest.qcow2 -F qcow2 d.qcow2; qemu-img convert -O qcow2 /usr/share/OVMF/OVMF_VARS_4M.fd vars.qcow2

$ order -machine q35 -m 1536 -drive file=d.qcow2,if=virtio $CODE -drive if=pflash,format=qcow2,file=vars.qcow2; show vars.qcow2 d.qcow2
vars.qcow2   VM SIZE 0 B
d.qcow2      VM SIZE 70 MiB

$ qemu-img create -q -f qcow2 a.qcow2 1G; qemu-img create -q -f qcow2 b.qcow2 1G

$ order -m 512 -drive file=b.qcow2,if=virtio -drive file=a.qcow2,if=virtio; show a.qcow2 b.qcow2
a.qcow2      VM SIZE 0 B
b.qcow2      VM SIZE 3.15 MiB

