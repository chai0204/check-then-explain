# 本文の端末ブロックから機械的に作った入力を、読者と同じ起動（docker run --rm -it --hostname linuc、
# ボリューム2つ、PID 1 の bash -l、umask 022、TERM=xterm）の1つのシェルに、第1章から第10章まで通して打った記録。
# 端末 200 桁 × 50 行。作り方: python3 -I probe/linuc-text-seq.py（イメージ lab-linuc-text:1.0.1）


========== 1. 01-quote.html ==========

$ cd ~/text

$ echo $HOME
/home/lab

$ echo '$HOME'
$HOME

$ echo "$HOME"
/home/lab

$ echo \$HOME
$HOME

$ echo "私は $(whoami) です"
私は lab です

$ echo '私は $(whoami) です'
私は $(whoami) です

$ echo "私は `whoami` です"
私は lab です

$ echo a     b
a b

$ echo "a     b"
a     b

$ msg="a     b"

$ echo $msg
a b

$ echo "$msg"
a     b

$ echo *.csv
scores.csv

$ echo "*.csv"
*.csv

$ echo -e 'a\tb'
a	b

$ echo 'a\tb'
a\tb

$ echo -n "改行なし"; echo "←ここまでが1行"
改行なし←ここまでが1行

$ cat child.sh
#!/bin/bash
echo "子のプロセスから見た GREETING=[$GREETING]"

$ GREETING=hello

$ echo "$GREETING"
hello

$ bash child.sh
子のプロセスから見た GREETING=[]

$ export GREETING

$ bash child.sh
子のプロセスから見た GREETING=[hello]

$ env | grep GREETING
GREETING=hello

$ set | grep "^GREETING="
GREETING=hello

$ LOCAL_ONLY=here

$ set | grep "^LOCAL_ONLY="
LOCAL_ONLY=here

$ env | grep "^LOCAL_ONLY="; echo "exit=$?"
exit=1

$ export -p | grep GREETING
declare -x GREETING="hello"

$ env | grep -c "^PATH="
1

$ set | grep -c "^PATH="
1

$ set | grep -c "^HISTSIZE="
1

$ env | grep -c "^HISTSIZE="
0

$ echo $SHLVL; bash -c "echo \$SHLVL"
1
2

$ GREETING=bye bash child.sh
子のプロセスから見た GREETING=[bye]

$ echo "$GREETING"
hello

$ env GREETING=env-bye bash child.sh
子のプロセスから見た GREETING=[env-bye]

$ env -i bash child.sh
子のプロセスから見た GREETING=[]

$ unset GREETING

$ echo "[$GREETING]"
[]

$ bash child.sh
子のプロセスから見た GREETING=[]

$ X=1 echo "[$X]"
[]

$ X=1; echo "[$X]"
[1]

$ set -o | grep -E "^(noclobber|xtrace|history) "
history        	on
noclobber      	off
xtrace         	off

$ bash -x child.sh
+ echo '子のプロセスから見た GREETING=[]'
子のプロセスから見た GREETING=[]


