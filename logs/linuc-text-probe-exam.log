========== 2. コマンドの在り処と履歴（試験対策の追加） ==========

$ cd ~/text

--- ここから下は、端末（pty）の上で対話シェルを動かし、1行ずつ打鍵した記録 ---
lab@linuc:~/text$  export PROMPT_COMMAND='PS1="\$ "'
$ bash
$ history -c
$ echo one
one
$ echo two
two
$ echo three
three
$ history
    1  echo one
    2  echo two
    3  echo three
    4  history
$ history -d 2
$ history
    1  echo one
    2  echo three
    3  history
    4  history -d 2
    5  history
$ printf '%s\n' 'echo from-file-1' 'echo from-file-2' > /tmp/hist.txt
$ history -r /tmp/hist.txt
$ history 4
    7  history -r /tmp/hist.txt
    8  echo from-file-1
    9  echo from-file-2
   10  history 4
$ history -c -w /tmp/hist.txt; wc -l /tmp/hist.txt
0 /tmp/hist.txt
$ exit
exit
$ exit
exit
