# --- 画面の写し: poweroff の後 ---
$ virsh domstate linuc --reason
shut off (shutdown)

$ virsh start linuc
Domain 'linuc' started

$

# --- ここまで ---

# --- 画面の写し: 端末1: 書いてすぐに電源を抜かれる ---
$ echo "抜く前に書いた" > memo.txt; ls -l memo.txt
-rw-rw-r-- 1 student student 22 Oct 13 19:25 memo.txt
$ Connection to 127.0.0.1 closed by remote host.
Connection to 127.0.0.1 closed.
$

# --- ここまで ---

# --- 画面の写し: 外: 動いている練習機を destroy して、また起動する ---
$ virsh destroy linuc
Domain 'linuc' destroyed

$ virsh start linuc
Domain 'linuc' started

$

# --- ここまで ---

# --- 画面の写し: 電源を抜かれた次の起動 ---
$ cat /run/initramfs/fsck.log
cat: /run/initramfs/fsck.log: Permission denied
$ ls -l memo.txt; cat memo.txt
ls: cannot access 'memo.txt': No such file or directory
cat: memo.txt: No such file or directory
$

# --- ここまで ---

