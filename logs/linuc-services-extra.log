========== 第6章の裏取り: su をブロックの中に書いて、設定ファイルを直接渡す ==========

$ echo 'local3.*  /var/log/lab-app.log' > /etc/rsyslog.d/60-lab.conf

$ systemctl restart rsyslog

$ for i in $(seq 1 60); do logger -p local3.info "かさ増し $i"; done

$ printf '/var/log/lab-app.log {\n    su root adm\n    size 1k\n    rotate 3\n    compress\n}\n' > /etc/logrotate.d/lab-app

$ chmod 644 /etc/logrotate.d/lab-app

$ logrotate -v /etc/logrotate.d/lab-app
