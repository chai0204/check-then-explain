========== 演習05 の模範解答の注記の裏取り: create と postrotate を書いた設定に su を足して、単体で渡す ==========

$ for i in $(seq 1 60); do logger -p local3.info "かさ増し2 $i"; done

$ printf '/var/log/lab-app.log {\n    su root adm\n    size 1k\n    rotate 3\n    missingok\n    notifempty\n    compress\n    create 0640 syslog adm\n    postrotate\n        systemctl kill -s HUP rsyslog.service\n    endscript\n}\n' > /etc/logrotate.d/lab-app

$ chmod 644 /etc/logrotate.d/lab-app

$ logrotate -v /etc/logrotate.d/lab-app
