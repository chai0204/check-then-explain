曲がったか


$ ls -l /var/mail/
total 8
-rw------- 1 alice mail 505 Oct 12 21:46 alice
-rw------- 1 bob   mail 509 Oct 12 21:46 bob

$ echo "--- ~/.forward でさらに曲げる ---"
--- ~/.forward でさらに曲げる ---

$ printf "root\n" > /home/bob/.forward; chown bob:bob /home/bob/.forward; ls -l /home/bob/.forward; cat /home/bob/.forward
-rw-rw-rw- 1 bob bob 5 Oct 12 21:46 /home/bob/.forward
root

$ echo "2回曲がる" | mail -s "forward 経由" alice; sleep 2

$ grep -c "forward 経由" /var/mail/root; echo "(root に届いた数)"
grep: /var/mail/root: No such file or directory
(root に届いた数)

$ tail -12 /var/mail/root
tail: cannot open '/var/mail/root' for reading: No such file or directory

$ echo "--- 配送できないとキューに残る ---"
--- 配送できないとキューに残る ---

$ echo x | mail -s "届かない宛先" nosuchuser@invalid.example; sleep 2; mailq
Mail queue is empty

$ postqueue -p; echo "exit=$?"
Mail queue is empty
exit=0

$ journalctl --no-pager -t postfix/local -n 6
Oct 12 21:46:35 a7c1d43cae23 postfix/local[540]: EE9821143EB7: to=<alice@lab.local>, orig_to=<alice>, relay=local, delay=0.02, delays=0.01/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)
Oct 12 21:46:38 a7c1d43cae23 postfix/local[540]: table hash:/etc/aliases(0,lock|no_regsub|no_proxy|no_unauth|fold_fix|utf8_request) has changed -- restarting
Oct 12 21:46:38 a7c1d43cae23 postfix/local[553]: 04F991143EBF: to=<bob@lab.local>, orig_to=<alice>, relay=local, delay=0.01, delays=0.01/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)
Oct 12 21:46:40 a7c1d43cae23 postfix/local[553]: warning: file /home/bob/.forward is world writable
Oct 12 21:46:40 a7c1d43cae23 postfix/local[553]: 0ACAE1143EC1: to=<bob@lab.local>, orig_to=<alice>, relay=local, delay=0.02, delays=0.02/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)
Oct 12 21:46:42 a7c1d43cae23 postfix/local[553]: 1E83B1143EC4: to=<root@lab.local>, relay=local, delay=0.01, delays=0/0/0/0, dsn=2.0.0, status=sent (delivered to mailbox)

