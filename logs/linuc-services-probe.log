{
	rotate 4
	weekly
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		/usr/lib/rsyslog/rsyslog-rotate
	endscript
}

$ printf "/var/log/lab-app.log {\n    rotate 3\n    size 1k\n    missingok\n    notifempty\n    compress\n    create 0640 syslog adm\n    postrotate\n        systemctl kill -s HUP rsyslog.service\n    endscript\n}\n" > /etc/logrotate.d/lab-app; cat /etc/logrotate.d/lab-app
/var/log/lab-app.log {
    rotate 3
    size 1k
    missingok
    notifempty
    compress
    create 0640 syslog adm
    postrotate
        systemctl kill -s HUP rsyslog.service
    endscript
}

