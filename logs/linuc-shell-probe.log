#!/bin/bash
line() {
    for ((i = 0; i < 20; i++)); do printf '-'; done
    printf '\n'
}
i=1
for name in "$@"; do
    echo "$i: $name"
    line
    i=$((i + 1))
done
1: alice
--------------------
