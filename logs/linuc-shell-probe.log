========== 5. 引数は渡す側で切られている — $0 $1 $# $@ $* shift（1.06.2） ==========
$ mkdir -p ~/try && cd ~/try
$ cat > args.sh <<'END'
> #!/bin/bash
> echo "\$0 = $0"
> echo "\$# = $#"
> echo "\$1 = $1"
> echo "\$2 = $2"
> echo '--- for a in "$@"'
> for a in "$@"; do echo "[$a]"; done
> echo '--- for a in "$*"'
> for a in "$*"; do echo "[$a]"; done
> echo '--- for a in $*'
> for a in $*; do echo "[$a]"; done
> END
$ chmod +x args.sh
$ ./args.sh "my file.txt" b
$0 = ./args.sh
$# = 2
$1 = my file.txt
$2 = b
--- for a in "$@"
[my file.txt]
[b]
--- for a in "$*"
[my file.txt b]
--- for a in $*
[my]
[file.txt]
[b]
$ ./args.sh my file.txt b
$0 = ./args.sh
$# = 3
$1 = my
$2 = file.txt
--- for a in "$@"
[my]
[file.txt]
[b]
--- for a in "$*"
[my file.txt b]
--- for a in $*
[my]
[file.txt]
[b]
$ touch "my file.txt"
$ cat > cpall.sh <<'END'
> #!/bin/bash
> cp $* /tmp/
> END
$ bash cpall.sh "my file.txt"; echo "終了ステータス $?"
cp: cannot stat 'my': No such file or directory
cp: cannot stat 'file.txt': No such file or directory
終了ステータス 1
$ sed -i 's/\$\*/"$@"/' cpall.sh; cat cpall.sh
#!/bin/bash
cp "$@" /tmp/
$ bash cpall.sh "my file.txt"; ls -l "/tmp/my file.txt"
-rw-r--r-- 1 lab lab 0 Oct 13 11:45 '/tmp/my file.txt'
$ cat > ten.sh <<'END'
> #!/bin/bash
> echo "\$# = $#"
> echo "\$10 = $10"
> echo "\${10} = ${10}"
> END
$ bash ten.sh a b c d e f g h i j
$# = 10
$10 = a0
${10} = j
$ cat > sh.sh <<'END'
> #!/bin/bash
> echo "はじめ:     \$# = $#  \$1 = $1  \$@ = $@"
> shift
> echo "shift 後:   \$# = $#  \$1 = $1  \$@ = $@"
> shift 2
> echo "shift 2 後: \$# = $#  \$1 = $1"
> shift 5
> echo "shift 5 の終了ステータス = $?  \$# = $#"
> END
$ bash sh.sh a b c d
はじめ:     $# = 4  $1 = a  $@ = a b c d
shift 後:   $# = 3  $1 = b  $@ = b c d
shift 2 後: $# = 1  $1 = d
shift 5 の終了ステータス = 1  $# = 1
$ cat > each.sh <<'END'
> #!/bin/bash
> while [ $# -gt 0 ]; do
>     echo "残り $# 個: [$1]"
>     shift
> done
> END
$ bash each.sh one "two three" four
残り 3 個: [one]
残り 2 個: [two three]
残り 1 個: [four]
$ set -- x "y z"; echo $#; echo "$2"
2
y z
$ cat > need.sh <<'END'
> #!/bin/bash
> if [ $# -ne 1 ]; then
>     echo "使い方: $(basename "$0") 名前" >&2
>     exit 1
> fi
> echo "こんにちは、$1"
> END
$ bash need.sh; echo "終了ステータス $?"
使い方: need.sh 名前
終了ステータス 1
$ bash need.sh alice
こんにちは、alice
$ bash need.sh alice bob 2> /dev/null; echo "終了ステータス $?"
終了ステータス 1
$ exit
logout


========== 6. 返せるのは 0〜255 の数1つ — $? exit test if（1.06.2） ==========
$ mkdir -p ~/try && cd ~/try
$ ls /nonexistent; echo $?
ls: cannot access '/nonexistent': No such file or directory
2
$ echo $?
0
$ grep -q lab /etc/passwd; echo $?
0
$ grep -q nosuchuser /etc/passwd; echo $?
1
$ grep -q lab /nonexistent; echo $?
grep: /nonexistent: No such file or directory
2
$ nosuchcommand; echo $?
bash: nosuchcommand: command not found
127
$ printf '#!/bin/bash\nexit 3\n' > ret.sh; bash ret.sh; echo $?
3
$ sed -i 's/exit 3/exit 255/' ret.sh; bash ret.sh; echo $?
255
$ sed -i 's/exit 255/exit 256/' ret.sh; cat ret.sh; bash ret.sh; echo $?
#!/bin/bash
exit 256
0
$ sed -i 's/exit 256/exit 257/' ret.sh; bash ret.sh; echo $?
1
$ bash -c 'exit -1'; echo $?
255
$ printf '#!/bin/bash\nls /nonexistent\necho おわり\n' > last.sh; bash last.sh; echo "終了ステータス $?"
ls: cannot access '/nonexistent': No such file or directory
おわり
終了ステータス 0
$ test -f /etc/passwd; echo $?
0
$ [ -f /etc/passwd ]; echo $?
0
$ [ -d /etc/passwd ]; echo $?
1
$ [ -e /nonexistent ]; echo $?
1
$ [ ! -e /nonexistent ]; echo $?
0
$ [ -r /etc/shadow ]; echo $?
1
$ [ -x /usr/bin/ls ]; echo $?
0
$ [ -s /etc/passwd ]; echo $?
0
$ [ -z "" ]; echo $?; [ -n "" ]; echo $?
0
1
$ [ 1 -eq 01 ]; echo $?; [ 1 = 01 ]; echo $?
0
1
$ [ 10 -gt 9 ]; echo $?; [ 10 \> 9 ]; echo $?
0
1
$ [ "abc" != "abd" ]; echo $?
0
$ x=; [ $x = yes ]; echo $?
bash: [: =: unary operator expected
2
$ [ "$x" = yes ]; echo $?
1
$ [1 -eq 1]; echo $?
bash: [1: command not found
127
$ type [ test [[
[ is a shell builtin
test is a shell builtin
[[ is a shell keyword
$ ls -l /usr/bin/[ /usr/bin/test
-rwxr-xr-x 1 root root 55744 Aug 26 00:09 '/usr/bin/['
-rwxr-xr-x 1 root root 47552 Aug 26 00:09  /usr/bin/test
$ cat > kind.sh <<'END'
> #!/bin/bash
> if [ -d "$1" ]; then
>     echo "$1 はディレクトリ"
> elif [ -f "$1" ]; then
>     echo "$1 はふつうのファイル"
> else
>     echo "$1 は見つからない"
>     exit 1
> fi
> END
$ bash kind.sh /etc; bash kind.sh /etc/passwd; bash kind.sh /nonexistent; echo "終了ステータス $?"
/etc はディレクトリ
/etc/passwd はふつうのファイル
/nonexistent は見つからない
終了ステータス 1
$ if grep -q '^alice:' /etc/passwd; then echo "alice は居る"; fi
alice は居る
$ [ -f /etc/passwd ] && [ -r /etc/passwd ] && echo "読める"
読める
$ [ -f /etc/passwd -a -r /etc/shadow ]; echo $?
