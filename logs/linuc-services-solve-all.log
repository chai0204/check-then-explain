########## B. 演習01 — 時刻の表示を3箇所で揃える ##########

$ date +%Z; timedatectl show -p Timezone --value; cat /etc/timezone; env | grep "^TZ="
JST
Etc/UTC
Etc/UTC
TZ=Asia/Tokyo

$ timedatectl set-timezone Asia/Tokyo

$ ls -l /etc/localtime; cat /etc/timezone
lrwxrwxrwx 1 root root 30 Oct 12 22:03 /etc/localtime -> /usr/share/zoneinfo/Asia/Tokyo
Etc/UTC

$ echo "Asia/Tokyo" > /etc/timezone; cat /etc/timezone
Asia/Tokyo

