# --- 画面の写し: kill -s 15 と kill -SIGKILL ---
$ sleep 801 &
[1] 727
$ kill -s 15 $!
$ sleep 802 &
[2] 731
[1]   Terminated              sleep 801
$ kill -SIGKILL $!
$ jobs
[2]+  Killed                  sleep 802
$

