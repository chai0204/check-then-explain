# --- 画面の写し: pkill と killall ---
$ sleep 601 &
[1] 733
$ sleep 602 &
[2] 734
$ sleep 603 &
[3] 735
$ jobs
[1]   Running                 sleep 601 &
[2]-  Running                 sleep 602 &
[3]+  Running                 sleep 603 &
$ pgrep -a -f 'sleep 60'
733 sleep 601
734 sleep 602
735 sleep 603
$ pkill -f 'sleep 601'
[1]   Terminated              sleep 601
$ jobs
[2]-  Running                 sleep 602 &
[3]+  Running                 sleep 603 &
$ killall sleep
[2]-  Terminated              sleep 602
[3]+  Terminated              sleep 603
$ jobs
$

