#!/bin/bash
# lab env の追加行。RPM 系の檻は apt を使わないので、代わりに dnf の固定先と道具の版を出す。
printf 'dnf 固定  : %s\n' 'https://vault.almalinux.org/9.7/（baseos / appstream / extras）'
printf 'rpm       : %s\n' "$(rpm -q --qf '%{VERSION}-%{RELEASE}' rpm)"
printf 'dnf       : %s\n' "$(rpm -q --qf '%{VERSION}-%{RELEASE}' dnf)"
