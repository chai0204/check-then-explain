#!/usr/bin/env bash
# lab — 読者が叩く唯一のコマンド。
#
# 設計の要点（works/learning-series/charter.md §6）:
#   - check は「観測した事実」だけを出し、直し方は言わない
#   - 合格時も「なぜ合格と判定したか」を1行出す（偶然通ったのか読者が判別できる）
#   - exit 2 は前提不足。読者の失敗にせず代替経路へ誘導する
#   - answer は閉じない。hint を使い切ったら solve で必ず到達できる
set -uo pipefail

LAB_HOME="${LAB_HOME:-/lab}"
THEME="${LAB_THEME:-base}"
STATE="${HOME}/.lab"
PROGRESS="${STATE}/progress.json"
WORK="${HOME}/work"

# sudo を付けて打たれたら、何もせずに止める。sudo は HOME を /root に替えるので、作業ディレクトリも
# 進み具合も /root の下にでき、~/work には現れない。/root はボリュームではないので、檻を抜けると消える。
# それでいて以前は「作業ファイルを ~/work/07 に展開しました」と出ていた（読者フィードバック 2026-10-22、
# 主題1.04: lab start が Permission denied で失敗し、sudo を付けると通ったので付け続けたら、~/work/07 ができなかった）。
if [ "$(id -u)" = 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
  printf '%s\n' "lab は sudo を付けずに打ちます（いま打ったのは sudo lab ${*:-}）。" \
    "  sudo を付けると root として動き、作業ディレクトリと進み具合が root のホーム（$HOME）の下にできます。" \
    "  ~/work には現れず、$HOME はボリュームではないので檻を抜けると消えます。何もせずに止めました。" \
    "  lab の操作は全部、sudo なしでできます（判定に root が要るところは、判定が自分で sudo を使います）。" >&2
  exit 1
fi

# lab の置き場（~/.lab の全部と、~/work そのもの）の持ち主が、いまの利用者でなくなっていたら戻す。
# 持ち主が root にずれた檻では、lab start が「Permission denied」で ~/work/NN を作れず、進み具合も
# 保存できなかった（同じ読者フィードバック。ずれたきっかけは分かっていない。公開中のイメージを docker・
# podman で本文どおりに使う限り、新しいボリュームも前の版のボリュームも lab の持ち物になることは確かめた）。
# ~/work/NN の中は演習の中身なので触らない（権限を扱う演習で、読者がわざと変えたものを戻さないため）。
not_mine() { { find "$STATE" "$WORK" -maxdepth 0 ! -user "$(id -un)"; find "$STATE" -mindepth 1 ! -user "$(id -un)"; } 2>/dev/null; }
heal_owner() {
  local me found was
  me=$(id -un)
  found=$(not_mine)
  [ -n "$found" ] || return 0
  was=$(printf '%s\n' "$found" | while IFS= read -r f; do stat -c '%n（持ち主 %U）' "$f" 2>/dev/null; done)
  sudo -n chown "$me:$(id -gn)" "$WORK" 2>/dev/null
  sudo -n chown -R "$me:$(id -gn)" "$STATE" 2>/dev/null
  # 戻せなかったら（sudo が無い檻・読み取り専用など）黙る。下の ⚠ と lab start の案内が事実を出す
  [ -z "$(not_mine)" ] || return 0
  printf '%s\n' "（lab の置き場の持ち主が $me ではなかったので、$me に戻しました。中身は変えていません）" >&2
  printf '%s\n' "$was" | sed 's/^/    /' >&2
  printf '\n' >&2
}

mkdir -p "$STATE" "$WORK" 2>/dev/null
heal_owner
# 進捗ファイルが書けない環境でも本体は動かす。黙って進捗が消えるのが最悪なので、そのときは理由を出す。
# 書き込みの失敗は { } 2>/dev/null で包む。`> f 2>/dev/null` の順だと、2>/dev/null が効く前に
# bash の「Permission denied」が画面に出る（2026-10-22 の読者の画面にはこれが出ていた）。
if [ ! -f "$PROGRESS" ]; then
  if ! { printf '{}\n' > "$PROGRESS"; } 2>/dev/null; then
    PROGRESS="$(mktemp)"; printf '{}\n' > "$PROGRESS"
    RO_STATE=1
  fi
elif [ ! -w "$PROGRESS" ]; then
  cp "$PROGRESS" "$(mktemp)" 2>/dev/null && PROGRESS="$_"
  RO_STATE=1
fi
if [ "${RO_STATE:-0}" = 1 ]; then
  printf '⚠ 進捗を保存できません（%s に書けない）。このセッション内だけ記録します。\n' "$STATE" >&2
  printf '  %s\n' "$(ls -ld "$STATE" 2>&1)" >&2
  printf '  檻を抜けてから進み具合のボリュームを消し、起動し直すと直ります（docker volume rm lab-%s-state）。\n\n' "${LAB_THEME:-x}" >&2
fi

c_ok=$'\033[32m'; c_ng=$'\033[31m'; c_wr=$'\033[33m'; c_d=$'\033[2m'; c_b=$'\033[1m'; c_0=$'\033[0m'
c_hd=$'\033[1;36m'; c_tag=$'\033[1;7m'
[ -t 1 ] || { c_ok=; c_ng=; c_wr=; c_d=; c_b=; c_0=; c_hd=; c_tag=; }

die() { printf '%s\n' "$*" >&2; exit 1; }
# 書けなくて止まるときに、事実（ls -ld の行）と、そのまま打てる直し方を出す。
# 「書けない」とだけ言うと、読者は sudo を付けて打ち直し、/root の下に作業してしまう。
cannot() {  # cannot 何ができないか 書けなかった場所
  local me; me=$(id -un)
  printf '%s\n' "$1。" "  $(ls -ld "$2" 2>&1)" >&2
  if [ "$(stat -c %U "$2" 2>/dev/null)" = "$me" ]; then
    printf '%s\n' "  持ち主は $me ですが、書き込みの許可がありません。次の1行で許可を足してから、同じコマンドを打ち直してください:" \
      "    chmod u+w $2" >&2
  elif sudo -n true 2>/dev/null; then
    printf '%s\n' "  持ち主が $me ではないので書けません。次の1行で持ち主を $me に戻してから、同じコマンドを打ち直してください:" \
      "    sudo chown -R $me: $2" >&2
  else
    printf '%s\n' "  持ち主が $me ではないので書けません。この檻では sudo が使えないので、檻を抜けてから" \
      "  作業のボリュームを消し、起動し直すと直ります（docker volume rm lab-${LAB_THEME:-x}-work。作業ファイルも消えます）。" >&2
  fi
  exit 1
}
# 演習を2つの檻に分けたコース（主題1.04）は、この檻に無い番号を打たれたとき、もう一方の檻をイメージの LAB_ELSEWHERE で案内する
elsewhere() { [ -z "${LAB_ELSEWHERE:-}" ] || printf '\n%s' "$LAB_ELSEWHERE"; }

# 演習番号の正規化（3 → 03）
norm() { printf '%02d' "$((10#${1#0}))" 2>/dev/null || printf '%s' "$1"; }

exercises() {
  find "$LAB_HOME/verify" -maxdepth 1 -name '[0-9][0-9].sh' -printf '%f\n' 2>/dev/null \
    | sed 's/\.sh$//' | sort
}

meta_get() {  # meta_get NN KEY
  local f="$LAB_HOME/verify/$1.meta"
  [ -f "$f" ] && sed -n "s/^$2=//p" "$f" | head -1
}

prog_get() { jq -r --arg k "$1" '.[$k].status // "todo"' "$PROGRESS"; }
prog_set() { # prog_set NN STATUS
  local tmp; tmp=$(mktemp)
  jq --arg k "$1" --arg s "$2" --arg t "$(date -Iseconds)" \
     '.[$k] = {status:$s, at:$t}' "$PROGRESS" > "$tmp" && mv "$tmp" "$PROGRESS"
}
hint_level() { jq -r --arg k "$1" '.[$k].hints // 0' "$PROGRESS"; }
hint_bump() {
  local tmp; tmp=$(mktemp)
  jq --arg k "$1" --argjson n "$2" '.[$k].hints = $n' "$PROGRESS" > "$tmp" && mv "$tmp" "$PROGRESS"
}

mark() {
  case "$1" in
    done)  printf '%s' "${c_ok}✔${c_0}" ;;
    solve) printf '%s' "${c_wr}◍${c_0}" ;;
    *)     printf '%s' "${c_d}·${c_0}" ;;
  esac
}

cmd_status() {
  local total=0 done_n=0 next=""
  for n in $(exercises); do
    total=$((total+1))
    case "$(prog_get "$n")" in
      done|solve) done_n=$((done_n+1)) ;;
      *) [ -z "$next" ] && next="$n" ;;
    esac
  done
  printf '%s\n' "${c_b}lab-${THEME}${c_0}  進捗 ${done_n}/${total}"
  local cur; cur=$(current_get)
  if [ -n "$cur" ] && [ -f "$LAB_HOME/tasks/$cur.md" ] && ! is_cleared "$cur"; then
    printf '  作業中 → %s 「%s」 %s\n' "$cur" "$(meta_get "$cur" title)" \
      "${c_d}(目安 $(meta_get "$cur" est_min)分 / 影響度 $(meta_get "$cur" impact))${c_0}"
    printf '  %s\n' "${c_d}lab show で課題文をもう一度 / lab check $cur で答え合わせ${c_0}"
  elif [ -n "$next" ]; then
    printf '  次 → %s 「%s」 %s\n' "$next" "$(meta_get "$next" title)" \
      "${c_d}(目安 $(meta_get "$next" est_min)分 / 影響度 $(meta_get "$next" impact))${c_0}"
    printf '  %s\n' "${c_d}lab start $next で課題を開く${c_0}"
  else
    printf '  %s\n' "${c_ok}全問クリア${c_0}"
  fi
  printf '  %s\n' "${c_d}進捗の保存先: ${PROGRESS}（消すには docker volume rm lab-${THEME}-state）${c_0}"
}

cmd_ls() {
  printf '%s\n' "${c_b}演習一覧${c_0}"
  for n in $(exercises); do
    printf '  %s %s  %-44s %s\n' "$(mark "$(prog_get "$n")")" "$n" \
      "$(meta_get "$n" title)" "${c_d}$(meta_get "$n" est_min)分 / 影響度 $(meta_get "$n" impact)${c_0}"
  done
  printf '\n  %s\n' "${c_d}✔ 自力で達成   ◍ solve を見た   · 未着手${c_0}"
}

# 開いている演習（lab show を引数なしで打ったときに出すもの）。進捗とは別のファイルに置く。
# progress.json に足すと、全演習の .at を集める finale の計算に混ざるため。
current_get() { cat "$STATE/current" 2>/dev/null | head -1; }
current_set() { { printf '%s\n' "$1" > "$STATE/current"; } 2>/dev/null || true; }
is_cleared() { case "$(prog_get "$1")" in done|solve) return 0 ;; *) return 1 ;; esac; }

# 課題文を見出しつきで出す（副作用なし。lab start と lab show の両方が使う）。
# 罫線は38字にする。罫線の文字は端末の設定で2桁ぶんの幅になることがあり、そのときも 80 桁に収まるように。
rule() { local ch=$1 i out=""; for i in $(seq 1 38); do out+="$ch"; done; printf '%s' "$out"; }
show_task() {
  local n=$1 task="$LAB_HOME/tasks/$1.md"
  printf '\n%s\n' "${c_hd}$(rule ━)${c_0}"
  local tag="【演習 $n】"; [ -n "$c_tag" ] && tag="${c_tag} 演習 $n ${c_0}"   # 色が無い端末では括弧で囲む
  printf ' %s  %s\n' "$tag" "${c_b}$(meta_get "$n" title)${c_0}"
  printf '          %s\n' "${c_d}影響度 $(meta_get "$n" impact) / 目安 $(meta_get "$n" est_min)分${c_0}"
  printf '%s\n\n' "${c_hd}$(rule ━)${c_0}"
  # 課題文の1行目（「演習 NN — 題 … 影響度 / 目安」）は上の見出しと同じなので省き、続く空行も省く
  awk -v n="$n" 'NR==1 && index($0, "演習 " n " — ")==1 {skip=1; next}
                 skip && NR==2 && $0=="" {next} {print}' "$task"
  printf '\n%s\n' "${c_d}$(rule ─)${c_0}"
}

# 課題文の後に、作業を始める場所と、課題文をもう一度出す方法を出す。
# 移動するコマンドをそのまま打てる形で出す。これを出していなかったとき、読者が書き込めない
# ディレクトリ（/home 等）のまま作業を始めて `unable to open database file` で詰まった。
# 演習がシステム全体を触る型（workdir=no）のときは ~/work へ誘導しない。
# 誘導すると、読者は /etc を触る課題なのに作業ディレクトリを探し始める。
# 元に戻す方法は檻ごとに違う（練習機のある檻は起動し直しても戻らない）ので、イメージが LAB_RESET_HINT で渡す。
task_footer() {
  local n=$1
  if [ "$(meta_get "$n" workdir)" = "no" ]; then
    printf '%s\n' "${c_d}この演習はシステム全体を触ります（作業ディレクトリは使いません）${c_0}"
    printf '%s\n' "${c_d}${LAB_RESET_HINT:-元に戻すには起動し直してください}${c_0}"
  else
    printf '%s\n' "${c_b}▶ 次はこれを打ってください${c_0}"
    printf '%s\n' "    cd ~/work/$n"
  fi
  printf '%s\n\n' "${c_d}この課題文は lab show でいつでももう一度出せます（答え合わせは lab check $n）${c_0}"
}

cmd_start() {
  local n; n=$(norm "${1:?lab start NN}")
  local task="$LAB_HOME/tasks/$n.md"
  [ -f "$task" ] || die "演習 $n は存在しません（lab ls で一覧）$(elsewhere)"
  # 作業ディレクトリは seed の有無に関わらず必ず作る。
  # seed だけを条件にすると、配布ファイルが無い演習で ~/work/NN が生まれず、
  # 読者が「どこで作業するのか」を自分で推測することになる。
  # 作れなかったとき・配れなかったときは、そう言って止める。以前は失敗を握りつぶして
  # 「展開しました」と出しており、読者は ~/work/NN が無い理由を知る手がかりが無かった（2026-10-22）。
  mkdir -p "$WORK/$n" 2>/dev/null || cannot "作業ディレクトリ ~/work/$n を作れません" "$WORK"
  local seed="$LAB_HOME/seed/$n" f
  if [ -d "$seed" ] && [ -n "$(ls -A "$seed" 2>/dev/null)" ]; then
    # 既にあるファイルは上書きしない（-n）。cp -n の終了コードは coreutils の版で違うので、配れたかは在るかで見る
    cp -rn "$seed/." "$WORK/$n/" 2>/dev/null
    while IFS= read -r f; do
      [ -e "$WORK/$n/$f" ] || cannot "作業ファイル $f を ~/work/$n に配れません" "$WORK/$n"
    done < <(ls -A "$seed")
    chmod -R u+w "$WORK/$n" 2>/dev/null || true
    printf '%s\n' "${c_d}作業ファイルを ~/work/$n に展開しました（$(ls -A "$seed" | tr '\n' ' ')）${c_0}"
  fi
  current_set "$n"
  show_task "$n"
  task_footer "$n"
}

# 課題文をもう一度出す。作業ファイルの展開も進捗の記録もしない。
# 番号を省くと、最後に lab start で開いた演習を出す（読者フィードバック 2026-10-20:
# 「start の文は後で見返しやすいように」。作業を進めると課題文が画面の上へ流れて見えなくなる）。
cmd_show() {
  local n
  if [ $# -ge 1 ]; then n=$(norm "$1"); else n=$(current_get); fi
  [ -n "$n" ] || die "まだ課題を開いていません。lab start NN で開いた後は、lab show だけで出せます（演習の一覧は lab ls）"
  [ -f "$LAB_HOME/tasks/$n.md" ] || die "演習 $n は存在しません（lab ls で一覧）$(elsewhere)"
  show_task "$n"
  task_footer "$n"
}

cmd_check() {
  local list
  if [ $# -ge 1 ]; then list=$(norm "$1"); else list=$(exercises); fi
  local rc_all=0
  for n in $list; do
    local v="$LAB_HOME/verify/$n.sh"
    [ -f "$v" ] || { printf '%s\n' "演習 $n は存在しません$(elsewhere)"; rc_all=1; continue; }
    local out rc
    out=$(cd "$WORK" && bash "$v" 2>&1); rc=$?
    case $rc in
      0)
        printf '%s %s %s\n' "${c_ok}✔${c_0}" "$n" "達成"
        printf '%s\n' "$out" | sed 's/^/  /'
        # 既に達成済みなら時刻を上書きしない。上書きすると、再チェックしたときに
        # 全演習の達成時刻が揃ってしまい、完走メッセージの所要時間が 0 になる。
        case "$(prog_get "$n")" in
          done|solve) ;;
          *) prog_set "$n" done ;;
        esac
        ;;
      2)
        printf '%s %s %s\n' "${c_wr}⚠${c_0}" "$n" "この環境では判定できません"
        printf '%s\n' "$out" | sed 's/^/  /'
        rc_all=2
        ;;
      *)
        printf '%s %s %s\n' "${c_ng}✗${c_0}" "$n" "未達"
        printf '%s\n' "$out" | sed 's/^/  /'
        printf '  %s\n' "${c_d}→ この事実から何が欠けているか考えてください。詰まったら lab hint $n${c_0}"
        rc_all=1
        ;;
    esac
  done
  finale_if_complete
  return $rc_all
}

# 全問達成したときに一度だけ出す。理論編には締めがあるのに実践編には無く、
# 終わった実感が出ないという指摘を受けて足した（読者フィードバック 2026-10-05）。
finale_if_complete() {
  local total=0 cleared=0 solved=0 n st
  for n in $(exercises); do
    total=$((total+1))
    st=$(prog_get "$n")
    case "$st" in
      done)  cleared=$((cleared+1)) ;;
      solve) cleared=$((cleared+1)); solved=$((solved+1)) ;;
    esac
  done
  [ "$total" -gt 0 ] && [ "$cleared" -eq "$total" ] || return 0
  [ -f "$STATE/finale" ] && return 0
  { : > "$STATE/finale"; } 2>/dev/null || true

  local sp="$LAB_HOME/spine.txt" title spine link
  if [ -f "$sp" ]; then
    title=$(sed -n '1p' "$sp")
    spine=$(awk 'NR>2 && $0 != "---"' "$sp" | sed '$d')
    link=$(tail -1 "$sp")
  else
    title="lab-${THEME}"; spine=""; link=""
  fi

  # 所要時間（最初の達成から最後の達成まで）
  local t0 t1 secs human=""
  t0=$(jq -r '[.[].at] | min // ""' "$PROGRESS" 2>/dev/null)
  t1=$(jq -r '[.[].at] | max // ""' "$PROGRESS" 2>/dev/null)
  if [ -n "$t0" ] && [ -n "$t1" ]; then
    secs=$(( $(date -d "$t1" +%s 2>/dev/null || echo 0) - $(date -d "$t0" +%s 2>/dev/null || echo 0) ))
    # 1分未満は出さない（「所要 0分」は不自然なので）
    if [ "$secs" -ge 60 ]; then
      if [ "$secs" -ge 3600 ]; then human="$((secs/3600))時間$(((secs%3600)/60))分"
      else human="$((secs/60))分"; fi
    fi
  fi

  # 罫線で囲まない。全角が混ざると桁が合わず、環境によって崩れる。
  printf '\n'
  printf '  %s\n' "${c_ok}════════════════════════════════════════${c_0}"
  printf '   %s\n' "${c_b}${title} — 全${total}演習クリア${c_0}"
  printf '  %s\n' "${c_ok}════════════════════════════════════════${c_0}"
  printf '\n'
  [ -n "$human" ] && printf '  %s\n\n' "${c_d}所要 ${human}（最初の達成から最後の達成まで）${c_0}"

  printf '  %s\n\n' "${c_b}自分の手で確かめたこと${c_0}"
  for n in $(exercises); do
    local l; l=$(meta_get "$n" learned)
    [ -n "$l" ] || l=$(meta_get "$n" title)
    printf '   %s %s  %s\n' "$(mark "$(prog_get "$n")")" "$n" "$l"
  done
  printf '\n'

  if [ -n "$spine" ]; then
    local cnt="${total}つ"; [ "$total" -ge 10 ] && cnt="${total}個"   # 「つ」で数えるのは9まで
    printf '  %s\n\n' "この${cnt}は全部、1つの事実から出ていました。"
    printf '%s\n' "$spine" | sed "s/^/      ${c_b}/; s/$/${c_0}/"
    printf '\n'
  fi

  if [ "$solved" -gt 0 ]; then
    printf '  %s\n' "${c_d}うち ${solved} 問は lab solve を見ました（◍）。気になるなら lab reset で解き直せます${c_0}"
  fi
  [ -n "$link" ] && printf '  %s\n' "${c_d}理論編の最終章に、それぞれがどう繋がるかを書いてあります → ${link}${c_0}"
  printf '\n'
}

cmd_hint() {
  local n; n=$(norm "${1:?lab hint NN}")
  local lv; lv=$(hint_level "$n"); lv=$((lv+1))
  local f="$LAB_HOME/hints/$n.$lv.md"
  if [ ! -f "$f" ]; then
    local last=$((lv-1))
    printf '%s\n' "ヒントは全${last}段まで使い切っています。"
    printf '%s\n' "${c_d}模範解答を見るなら: lab solve $n${c_0}"
    printf '%s\n' "${c_d}（見ても構いません。答えは1コマンド離れた場所にあります）${c_0}"
    return 0
  fi
  hint_bump "$n" "$lv"
  printf '\n%s\n\n' "${c_b}ヒント $lv 段目${c_0}"
  cat "$f"; printf '\n'
  [ -f "$LAB_HOME/hints/$n.$((lv+1)).md" ] \
    && printf '%s\n' "${c_d}まだ足りなければ lab hint $n（次の段）${c_0}" \
    || printf '%s\n' "${c_d}これが最後のヒントです。次は lab solve $n${c_0}"
}

cmd_solve() {
  local n; n=$(norm "${1:?lab solve NN}")
  local f="$LAB_HOME/solutions/$n.md"
  [ -f "$f" ] || die "演習 $n の解答はありません"
  printf '\n%s\n\n' "${c_b}模範解答 $n${c_0}"
  cat "$f"; printf '\n'
  [ "$(prog_get "$n")" = "done" ] || prog_set "$n" solve
  printf '%s\n' "${c_d}この演習は「solve を見た」として記録しました（lab ls で ◍ 表示）${c_0}"
}

cmd_reset() {
  local n; n=$(norm "${1:?lab reset NN}")
  [ -f "$LAB_HOME/tasks/$n.md" ] || die "演習 $n は存在しません（lab ls で一覧）$(elsewhere)"
  rm -rf "$WORK/$n" 2>/dev/null
  # 演習の中で sudo を付けて作ったファイル（root の持ち物）は、lab のままでは消せない。
  # 「初期状態に戻す」と頼まれたので、残ったら sudo で消す（それでも残れば、そう言って止める）
  [ -e "$WORK/$n" ] && sudo -n rm -rf "$WORK/$n" 2>/dev/null
  [ -e "$WORK/$n" ] && cannot "~/work/$n を消せません（初期状態に戻せません）" "$WORK/$n"
  # lab start と同じく、配布物が無い演習でも ~/work/NN は作り直す（実践編に「ディレクトリごと作り直されます」
  # と書いてある。以前は配布物の無い演習で消したままになり、読者が cd ~/work/NN で戻れなかった）
  mkdir -p "$WORK/$n" 2>/dev/null || cannot "作業ディレクトリ ~/work/$n を作れません" "$WORK"
  local seed="$LAB_HOME/seed/$n"
  if [ -d "$seed" ]; then
    cp -r "$seed/." "$WORK/$n/" 2>/dev/null || cannot "作業ファイルを ~/work/$n に配れません" "$WORK/$n"
    chmod -R u+w "$WORK/$n" 2>/dev/null || true     # lab start と同じく、配ったファイルは書ける状態にする
  fi
  local tmp; tmp=$(mktemp)
  jq --arg k "$n" 'del(.[$k])' "$PROGRESS" > "$tmp" && mv "$tmp" "$PROGRESS"
  printf '%s\n' "演習 $n を初期状態に戻しました（~/work/$n）"
}

cmd_env() {
  # 本文の「検証環境ブロック」にそのまま貼れる形式で出す
  printf 'テーマ    : lab-%s %s\n' "$THEME" "${LAB_VERSION:-?}"
  printf 'イメージ  : %s\n' "${LAB_IMAGE:-未設定}"
  printf 'ベース    : %s\n' "$(. /etc/os-release && printf '%s' "$PRETTY_NAME")"
  printf 'apt 固定  : %s\n' "${LAB_APT_SNAPSHOT:-未設定}"
  printf 'カーネル  : %s\n' "$(uname -r)"
  printf 'アーキ    : %s\n' "$(uname -m)"
  # ランタイムは不具合の切り分けに要る。既定の Bounding セットが両者で違う
  # （実測 2026-10-06: docker 29.8.0 → a80425fb / podman 5.8.6 rootless → 800405fb）。
  # 判別は両者が置くファイルで行う。podman は /run/.containerenv、docker は /.dockerenv。
  local rt
  if   [ -e /run/.containerenv ]; then rt=podman
  elif [ -e /.dockerenv ];        then rt=docker
  else                                 rt='不明'
  fi
  printf 'ランタイム: %s\n' "$rt"
  if [ -x "$LAB_HOME/bin/env-extra" ]; then "$LAB_HOME/bin/env-extra"; fi
  # CapEff はこのイメージでは常に 0（uid 1000 で動くため --cap-add は effective に入らない）。
  # 0 でないなら読者が --user 0 などで起動している。CapBnd はランタイムの既定を示す。
  printf '特権      : CapEff=%s CapBnd=%s\n' \
    "$(awk '/^CapEff/{print $2}' /proc/self/status)" \
    "$(awk '/^CapBnd/{print $2}' /proc/self/status)"
}

usage() {
  cat <<EOF
lab — 学習ラボのコマンド

  lab                現在地と次の一手
  lab ls             演習一覧と達成状況
  lab start NN       課題を開き、作業ファイルを ~/work/NN に展開する
  lab show [NN]      課題文をもう一度出す（省略時は最後に開いた演習）
  lab check [NN]     答え合わせ（省略時は全問）
  lab hint NN        ヒントを1段出す（呼ぶたび深くなる）
  lab solve NN       模範解答を見る（使ったことは記録に残る）
  lab reset NN       演習を初期状態に戻す
  lab env            検証環境を表示する（本文に貼れる形式）
EOF
}

case "${1:-status}" in
  ""|status) cmd_status ;;
  ls)     cmd_ls ;;
  start)  shift; cmd_start "$@" ;;
  show)   shift; cmd_show "$@" ;;
  check)  shift; cmd_check "$@" ;;
  hint)   shift; cmd_hint "$@" ;;
  solve)  shift; cmd_solve "$@" ;;
  reset)  shift; cmd_reset "$@" ;;
  env)    cmd_env ;;
  -h|--help|help) usage ;;
  *) printf 'unknown subcommand: %s\n\n' "$1"; usage; exit 1 ;;
esac
